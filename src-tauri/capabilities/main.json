{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The minimum set of permissions required by the DarkLoad main window.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-set-decorations",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/*" },
        { "url": "https://www.youtube.com/*" },
        { "url": "https://www.tiktok.com/*" },
        { "url": "https://www.instagram.com/*" }
      ]
    },
    "allow-app-info",
    "allow-app-check-update",
    "allow-app-install-update",
    "allow-detect-url",
    "allow-analyze-url",
    "allow-cancel-analysis",
    "allow-cache-thumbnail",
    "allow-plan-download",
    "allow-enqueue-downloads",
    "allow-queue-list",
    "allow-queue-cancel",
    "allow-queue-pause",
    "allow-queue-resume",
    "allow-queue-retry",
    "allow-queue-remove",
    "allow-queue-clear-finished",
    "allow-queue-move",
    "allow-queue-pause-all",
    "allow-queue-resume-all",
    "allow-queue-reveal",
    "allow-queue-open",
    "allow-history-query",
    "allow-history-stats",
    "allow-history-find-completed",
    "allow-history-open",
    "allow-history-reveal",
    "allow-history-redownload",
    "allow-history-delete",
    "allow-history-clear",
    "allow-open-download-folder",
    "allow-settings-get",
    "allow-settings-update",
    "allow-settings-reset",
    "allow-deps-status",
    "allow-deps-refresh",
    "allow-deps-check-updates",
    "allow-deps-install",
    "allow-deps-diagnostics",
    "allow-clear-temporary-files",
    "allow-validate-directory",
    "allow-has-active-downloads",
    "allow-accounts-status",
    "allow-accounts-connect",
    "allow-accounts-disconnect"
  ]
}
